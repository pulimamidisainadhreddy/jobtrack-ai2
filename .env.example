# Neon PostgreSQL pooled connection string. Keep it private!
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Protect your online tracker. Use a unique, strong password.
TRACKER_PASSWORD="choose-a-long-private-password"
# Random long string for signing secure sessions. DO NOT expose in NEXT_PUBLIC variables.
AUTH_SECRET="replace-with-at-least-32-random-characters"
